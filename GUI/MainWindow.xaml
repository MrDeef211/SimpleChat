<Window x:Class="GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Chat" Height="560" Width="820">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- локальный пользователь -->
            <RowDefinition Height="Auto"/>
            <!-- discovery -->
            <RowDefinition Height="*"/>
            <!-- история -->
            <RowDefinition Height="Auto"/>
            <!-- отправка -->
        </Grid.RowDefinitions>

        <!-- Локальный пользователь -->
        <GroupBox Grid.Row="0" Header="Вы" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Имя:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock x:Name="TxtLocalName" FontWeight="Bold" VerticalAlignment="Center"
                           Margin="0,0,15,0" Text="—"/>
                <TextBlock Text="ID:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock x:Name="TxtLocalId" VerticalAlignment="Center" Opacity="0.6" Text="—"/>
            </StackPanel>
        </GroupBox>

        <!-- Обнаружение пользователей -->
        <GroupBox Grid.Row="1" Header="Пользователи в сети" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="LstUsers" Grid.Column="0" Height="130"
                         SelectionMode="Single"
                         MouseDoubleClick="LstUsers_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#9E9E9E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="#2ECC71"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Column="1" Margin="8,0,0,0" Width="160">
                    <Button x:Name="BtnRefresh" Content="Обновить" Margin="0,0,0,5"
                            Click="BtnRefresh_Click" Padding="10,4"/>
                    <Button x:Name="BtnConnect" Content="Подключиться"
                            Margin="0,0,0,5" Click="BtnConnect_Click" Padding="10,4"/>
                    <Button x:Name="BtnRename" Content="Переименовать..."
                            Margin="0,0,0,5" Click="BtnRename_Click" Padding="10,4"/>
                    <Button x:Name="BtnDisconnect" Content="Отключиться"
                            Click="BtnDisconnect_Click" Padding="10,4"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- История сообщений -->
        <ListBox x:Name="LstMessages" Grid.Row="2" Margin="0,0,0,10"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

        <!-- Панель отправки -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" MinWidth="100"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtReceiver" Grid.Column="0" Margin="0,0,5,0"
                     ToolTip="Имя получателя"
                     IsReadOnly="True"/>

            <TextBox x:Name="TxtMessage" Grid.Column="1" Margin="0,0,5,0"
                     ToolTip="Текст сообщения"
                     KeyDown="TxtMessage_KeyDown"/>

            <Button x:Name="BtnSend" Grid.Column="2" Content="Отправить"
                    Click="BtnSend_Click" Padding="15,2"/>
        </Grid>
    </Grid>
</Window>